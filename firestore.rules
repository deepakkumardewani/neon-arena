rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authed() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return authed() && request.auth.uid == uid;
    }

    /** Queue doc id is either auth uid (legacy) or uid + "_na_mm_" + 32 hex (per-tab). */
    function ownQueueDoc(docId) {
      return authed()
        && (
          docId == request.auth.uid
          || docId.matches("^" + request.auth.uid + "_na_mm_[a-f0-9]{32}$")
        );
    }

    match /scores/{uid} {
      allow read: if authed();
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /queue/{queueDocId} {
      allow read: if authed();
      allow create, update, delete: if ownQueueDoc(queueDocId);
    }

    match /games/{gameId} {
      allow read: if authed();
      allow create: if authed();

      allow update: if authed()
        && (
          resource.data.playerX.uid == request.auth.uid
          || ('playerO' in resource.data
            && resource.data.playerO != null
            && resource.data.playerO.uid == request.auth.uid)
        );

      allow delete: if false;
    }
  }
}
